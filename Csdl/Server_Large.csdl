<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx xmlns="http://docs.oasis-open.org/odata/ns/edm" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:DataServices>
    <Schema Namespace="Microsoft.Graph">
      <EntityType Name="User">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="displayName" Type="Edm.String" />
        <Property Name="userPrincipalName" Type="Edm.String" />
        <Property Name="mail" Type="Edm.String" Nullable="true" />
        <Property Name="jobTitle" Type="Edm.String" Nullable="true" />
        <Property Name="department" Type="Edm.String" Nullable="true" />
        <Property Name="officeLocation" Type="Edm.String" Nullable="true" />
        <Property Name="mobilePhone" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="manager" Type="Microsoft.Graph.User" />
        <NavigationProperty Name="directReports" Type="Collection(Microsoft.Graph.User)" />
        <NavigationProperty Name="memberOf" Type="Collection(Microsoft.Graph.Group)" />
        <NavigationProperty Name="drive" Type="Microsoft.Graph.Drive" />
        <NavigationProperty Name="joinedTeams" Type="Collection(Microsoft.Graph.Team)" />
        <NavigationProperty Name="chats" Type="Collection(Microsoft.Graph.Chat)" />
        <NavigationProperty Name="todoLists" Type="Collection(Microsoft.Graph.TodoTaskList)" />
      </EntityType>

      <EntityType Name="Group">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="displayName" Type="Edm.String" />
        <Property Name="description" Type="Edm.String" Nullable="true" />
        <Property Name="mail" Type="Edm.String" Nullable="true" />
        <Property Name="mailNickname" Type="Edm.String" Nullable="true" />
        <Property Name="groupTypes" Type="Collection(Edm.String)" />
        <Property Name="mailEnabled" Type="Edm.Boolean" Nullable="false" />
        <Property Name="securityEnabled" Type="Edm.Boolean" Nullable="false" />
        <Property Name="visibility" Type="Edm.String" Nullable="true" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <NavigationProperty Name="members" Type="Collection(Microsoft.Graph.User)" />
        <NavigationProperty Name="owners" Type="Collection(Microsoft.Graph.User)" />
        <NavigationProperty Name="drive" Type="Microsoft.Graph.Drive" />
        <NavigationProperty Name="team" Type="Microsoft.Graph.Team" />
      </EntityType>

      <EntityType Name="Drive">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="name" Type="Edm.String" />
        <Property Name="driveType" Type="Edm.String" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <Property Name="ownerDisplayName" Type="Edm.String" Nullable="true" />
        <Property Name="quotaTotal" Type="Edm.Int64" Nullable="true" />
        <Property Name="quotaUsed" Type="Edm.Int64" Nullable="true" />
        <NavigationProperty Name="root" Type="Microsoft.Graph.DriveItem" />
        <NavigationProperty Name="items" Type="Collection(Microsoft.Graph.DriveItem)" />
      </EntityType>

      <EntityType Name="DriveItem">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="name" Type="Edm.String" />
        <Property Name="size" Type="Edm.Int64" Nullable="true" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <Property Name="fileMimeType" Type="Edm.String" Nullable="true" />
        <Property Name="isFolder" Type="Edm.Boolean" Nullable="false" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="lastModifiedDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="lastModifiedByDisplayName" Type="Edm.String" Nullable="true" />
        <Property Name="lastModifiedByUpn" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="children" Type="Collection(Microsoft.Graph.DriveItem)" />
        <NavigationProperty Name="lastModifiedByUser" Type="Microsoft.Graph.User" />
      </EntityType>

      <EntityType Name="Team">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="displayName" Type="Edm.String" />
        <Property Name="description" Type="Edm.String" Nullable="true" />
        <Property Name="visibility" Type="Edm.String" Nullable="true" />
        <Property Name="isArchived" Type="Edm.Boolean" Nullable="false" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <NavigationProperty Name="channels" Type="Collection(Microsoft.Graph.Channel)" />
        <NavigationProperty Name="primaryChannel" Type="Microsoft.Graph.Channel" />
        <NavigationProperty Name="members" Type="Collection(Microsoft.Graph.User)" />
        <NavigationProperty Name="owners" Type="Collection(Microsoft.Graph.User)" />
      </EntityType>

      <EntityType Name="Channel">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="teamId" Type="Edm.String" Nullable="true" />
        <Property Name="displayName" Type="Edm.String" />
        <Property Name="description" Type="Edm.String" Nullable="true" />
        <Property Name="membershipType" Type="Edm.String" Nullable="true" />
        <Property Name="email" Type="Edm.String" Nullable="true" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <NavigationProperty Name="messages" Type="Collection(Microsoft.Graph.ChatMessage)" />
        <NavigationProperty Name="members" Type="Collection(Microsoft.Graph.User)" />
        <NavigationProperty Name="filesFolder" Type="Microsoft.Graph.DriveItem" />
      </EntityType>

      <EntityType Name="Chat">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="topic" Type="Edm.String" Nullable="true" />
        <Property Name="chatType" Type="Edm.String" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="lastUpdatedDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="messages" Type="Collection(Microsoft.Graph.ChatMessage)" />
        <NavigationProperty Name="members" Type="Collection(Microsoft.Graph.User)" />
      </EntityType>

      <EntityType Name="ChatMessage">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="subject" Type="Edm.String" Nullable="true" />
        <Property Name="summary" Type="Edm.String" Nullable="true" />
        <Property Name="bodyContent" Type="Edm.String" Nullable="true" />
        <Property Name="fromDisplayName" Type="Edm.String" Nullable="true" />
        <Property Name="fromUpn" Type="Edm.String" Nullable="true" />
        <Property Name="importance" Type="Edm.String" Nullable="true" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="webUrl" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="sender" Type="Microsoft.Graph.User" />
      </EntityType>

      <EntityType Name="TodoTaskList">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="displayName" Type="Edm.String" />
        <Property Name="isOwner" Type="Edm.Boolean" Nullable="false" />
        <Property Name="isShared" Type="Edm.Boolean" Nullable="false" />
        <Property Name="wellknownListName" Type="Edm.String" Nullable="true" />
        <NavigationProperty Name="tasks" Type="Collection(Microsoft.Graph.TodoTask)" />
      </EntityType>

      <EntityType Name="TodoTask">
        <Key>
          <PropertyRef Name="id" />
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false" />
        <Property Name="listId" Type="Edm.String" Nullable="true" />
        <Property Name="listDisplayName" Type="Edm.String" Nullable="true" />
        <Property Name="title" Type="Edm.String" />
        <Property Name="bodyPreview" Type="Edm.String" Nullable="true" />
        <Property Name="status" Type="Edm.String" />
        <Property Name="importance" Type="Edm.String" />
        <Property Name="isReminderOn" Type="Edm.Boolean" Nullable="false" />
        <Property Name="createdDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="dueDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="completedDateTime" Type="Edm.DateTimeOffset" Nullable="true" />
        <Property Name="assignedToUpn" Type="Edm.String" Nullable="true" />
      </EntityType>

      <Function Name="searchDriveItems" IsBound="true">
        <Parameter Name="bindingParameter" Type="Microsoft.Graph.Drive" />
        <Parameter Name="q" Type="Edm.String" Nullable="false" />
        <ReturnType Type="Collection(Microsoft.Graph.DriveItem)" />
      </Function>

      <Function Name="recentDriveItems" IsBound="true">
        <Parameter Name="bindingParameter" Type="Microsoft.Graph.Drive" />
        <ReturnType Type="Collection(Microsoft.Graph.DriveItem)" />
      </Function>

      <Function Name="deltaChannelMessages" IsBound="true">
        <Parameter Name="bindingParameter" Type="Microsoft.Graph.Channel" />
        <ReturnType Type="Collection(Microsoft.Graph.ChatMessage)" />
      </Function>

      <Action Name="sendChannelMessage" IsBound="true">
        <Parameter Name="bindingParameter" Type="Microsoft.Graph.Channel" />
        <Parameter Name="subject" Type="Edm.String" />
        <Parameter Name="bodyContent" Type="Edm.String" Nullable="false" />
        <ReturnType Type="Microsoft.Graph.ChatMessage" />
      </Action>

      <Action Name="completeTodoTask" IsBound="true">
        <Parameter Name="bindingParameter" Type="Microsoft.Graph.TodoTask" />
        <ReturnType Type="Microsoft.Graph.TodoTask" />
      </Action>

      <EntityContainer Name="GraphService">
        <EntitySet Name="users" EntityType="Microsoft.Graph.User">
          <NavigationPropertyBinding Path="manager" Target="users" />
          <NavigationPropertyBinding Path="directReports" Target="users" />
          <NavigationPropertyBinding Path="memberOf" Target="groups" />
          <NavigationPropertyBinding Path="drive" Target="drives" />
          <NavigationPropertyBinding Path="joinedTeams" Target="teams" />
          <NavigationPropertyBinding Path="chats" Target="chats" />
          <NavigationPropertyBinding Path="todoLists" Target="todoLists" />
        </EntitySet>

        <Singleton Name="me" Type="Microsoft.Graph.User">
          <NavigationPropertyBinding Path="manager" Target="users" />
          <NavigationPropertyBinding Path="directReports" Target="users" />
          <NavigationPropertyBinding Path="memberOf" Target="groups" />
          <NavigationPropertyBinding Path="drive" Target="drives" />
          <NavigationPropertyBinding Path="joinedTeams" Target="teams" />
          <NavigationPropertyBinding Path="chats" Target="chats" />
          <NavigationPropertyBinding Path="todoLists" Target="todoLists" />
        </Singleton>

        <EntitySet Name="groups" EntityType="Microsoft.Graph.Group">
          <NavigationPropertyBinding Path="members" Target="users" />
          <NavigationPropertyBinding Path="owners" Target="users" />
          <NavigationPropertyBinding Path="drive" Target="drives" />
          <NavigationPropertyBinding Path="team" Target="teams" />
        </EntitySet>

        <EntitySet Name="drives" EntityType="Microsoft.Graph.Drive">
          <NavigationPropertyBinding Path="root" Target="driveItems" />
          <NavigationPropertyBinding Path="items" Target="driveItems" />
        </EntitySet>

        <EntitySet Name="driveItems" EntityType="Microsoft.Graph.DriveItem">
          <NavigationPropertyBinding Path="children" Target="driveItems" />
          <NavigationPropertyBinding Path="lastModifiedByUser" Target="users" />
        </EntitySet>

        <EntitySet Name="teams" EntityType="Microsoft.Graph.Team">
          <NavigationPropertyBinding Path="channels" Target="channels" />
          <NavigationPropertyBinding Path="primaryChannel" Target="channels" />
          <NavigationPropertyBinding Path="members" Target="users" />
          <NavigationPropertyBinding Path="owners" Target="users" />
        </EntitySet>

        <EntitySet Name="channels" EntityType="Microsoft.Graph.Channel">
          <NavigationPropertyBinding Path="messages" Target="chatMessages" />
          <NavigationPropertyBinding Path="members" Target="users" />
          <NavigationPropertyBinding Path="filesFolder" Target="driveItems" />
        </EntitySet>

        <EntitySet Name="chats" EntityType="Microsoft.Graph.Chat">
          <NavigationPropertyBinding Path="messages" Target="chatMessages" />
          <NavigationPropertyBinding Path="members" Target="users" />
        </EntitySet>

        <EntitySet Name="chatMessages" EntityType="Microsoft.Graph.ChatMessage">
          <NavigationPropertyBinding Path="sender" Target="users" />
        </EntitySet>

        <EntitySet Name="todoLists" EntityType="Microsoft.Graph.TodoTaskList">
          <NavigationPropertyBinding Path="tasks" Target="todoTasks" />
        </EntitySet>

        <EntitySet Name="todoTasks" EntityType="Microsoft.Graph.TodoTask">
        </EntitySet>

        <Annotation Term="Agent.Prompts">
          <Collection>
            <Record>
              <PropertyValue Property="Name" String="whom_olga_reports_to" />
              <PropertyValue Property="Title" String="Whom Avery reports to?" />
              <PropertyValue Property="Description" String="Find organizational manager for Avery Adams or any given user." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userName" />
                    <PropertyValue Property="Description" String="User display name or UPN" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Avery Adams" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Whom does {userName} report to? Query GET users?$filter=startswith(displayName,'{userName}') or startswith(userPrincipalName,'{userName}')&amp;$select=id,displayName,userPrincipalName,jobTitle,department to resolve the user, then query GET users('{userId}')/manager?$select=id,displayName,userPrincipalName,jobTitle,department." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="who_are_olgas_peers" />
              <PropertyValue Property="Title" String="Who are Avery's peers?" />
              <PropertyValue Property="Description" String="Discover peer colleagues reporting to the same manager as Avery Adams." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userName" />
                    <PropertyValue Property="Description" String="User display name or UPN" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Avery Adams" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Who are {userName}'s peers? Query GET users?$filter=startswith(displayName,'{userName}') or startswith(userPrincipalName,'{userName}')&amp;$select=id,displayName,userPrincipalName to resolve the user, query GET users('{userId}')/manager?$select=id,displayName,userPrincipalName, and then query GET users('{managerId}')/directReports?$select=id,displayName,userPrincipalName,jobTitle,department." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="direct_reports_of_manager" />
              <PropertyValue Property="Title" String="Direct reports of a manager" />
              <PropertyValue Property="Description" String="List all members reporting directly to a given manager." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="managerNameOrId" />
                    <PropertyValue Property="Description" String="Manager's name, ID, or UPN" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Morgan Reed" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List direct reports for manager {managerNameOrId}. Query GET users?$filter=startswith(displayName,'{managerNameOrId}') or startswith(userPrincipalName,'{managerNameOrId}')&amp;$select=id,displayName,userPrincipalName to resolve the manager, then query GET users('{managerId}')/directReports?$select=id,displayName,userPrincipalName,jobTitle,department." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="search_users_by_dept_title" />
              <PropertyValue Property="Title" String="Search users by department and title" />
              <PropertyValue Property="Description" String="Search users filtered by organizational department and job title." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="department" />
                    <PropertyValue Property="Description" String="Department name" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Identity" />
                  </Record>
                  <Record>
                    <PropertyValue Property="Name" String="jobTitle" />
                    <PropertyValue Property="Description" String="Job title keyword" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Architect" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Find users in department '{department}' with title '{jobTitle}'. Query GET users?$filter=department eq '{department}' and startswith(jobTitle,'{jobTitle}')&amp;$select=id,displayName,userPrincipalName,mail,jobTitle,department,officeLocation." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="user_quick_lookup" />
              <PropertyValue Property="Title" String="User quick lookup" />
              <PropertyValue Property="Description" String="Quick lookup of user contact card and organization profile." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="identifier" />
                    <PropertyValue Property="Description" String="User ID, UPN, or 'me'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="me" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Display the complete profile card for '{identifier}'. If '{identifier}' is 'me', query GET me?$select=id,displayName,userPrincipalName,mail,jobTitle,department,officeLocation&amp;$expand=manager,directReports; otherwise query GET users('{identifier}')?$select=id,displayName,userPrincipalName,mail,jobTitle,department,officeLocation&amp;$expand=manager,directReports." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="find_group_by_name" />
              <PropertyValue Property="Title" String="Find group by name" />
              <PropertyValue Property="Description" String="Search for a Microsoft 365 or Security group by display name or prefix." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="groupName" />
                    <PropertyValue Property="Description" String="Group name or search keyword" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Find the group '{groupName}'. Query GET groups?$filter=startswith(displayName,'{groupName}') or startswith(mailNickname,'{groupName}')&amp;$select=id,displayName,description,mail,mailNickname,groupTypes,securityEnabled,visibility." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="list_group_members" />
              <PropertyValue Property="Title" String="List members of a group" />
              <PropertyValue Property="Description" String="List all members belonging to a specified group." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="groupIdOrName" />
                    <PropertyValue Property="Description" String="Group ID or name" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List all members of group '{groupIdOrName}'. Resolve the group with GET groups?$filter=startswith(displayName,'{groupIdOrName}')&amp;$select=id,displayName, then query GET groups('{groupId}')/members?$select=id,displayName,userPrincipalName,jobTitle,department." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="who_owns_group" />
              <PropertyValue Property="Title" String="Who is the owner of a group?" />
              <PropertyValue Property="Description" String="Identify the owners and managers of a specified group." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="groupIdOrName" />
                    <PropertyValue Property="Description" String="Group ID or name" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Who is the owner of group '{groupIdOrName}'? Resolve the group with GET groups?$filter=startswith(displayName,'{groupIdOrName}')&amp;$select=id,displayName, then query GET groups('{groupId}')/owners?$select=id,displayName,userPrincipalName,jobTitle,department." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="group_quick_lookup" />
              <PropertyValue Property="Title" String="Group quick lookup" />
              <PropertyValue Property="Description" String="Quick lookup of group profile, membership, and catalog." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="identifier" />
                    <PropertyValue Property="Description" String="Group ID, display name, or 'groups'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="groups" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Display group information for '{identifier}'. If '{identifier}' is 'groups', query GET groups?$top=100&amp;$select=id,displayName,description,mail,mailNickname,groupTypes,securityEnabled,visibility; otherwise query GET groups('{identifier}')?$select=id,displayName,description,mail,mailNickname,groupTypes,securityEnabled,visibility&amp;$expand=members,owners." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="user_peers_in_group" />
              <PropertyValue Property="Title" String="Which user peers belong to a group?" />
              <PropertyValue Property="Description" String="Intersect a user's reporting peers with a directory group's members. User data alone lacks membership; group data alone lacks reporting peers." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userName" />
                    <PropertyValue Property="Description" String="User display name, ID, UPN, or me" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Avery Adams" />
                  </Record>
                  <Record>
                    <PropertyValue Property="Name" String="groupName" />
                    <PropertyValue Property="Description" String="Group display name or ID" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Which peers of '{userName}' belong to group '{groupName}'? 1. Resolve the user with GET users?$filter=startswith(displayName,'{userName}') or startswith(userPrincipalName,'{userName}')&amp;$select=id,displayName,userPrincipalName and the group with GET groups?$filter=startswith(displayName,'{groupName}')&amp;$select=id,displayName; clarify multiple matches. 2. Query GET users('{userId}')/manager/directReports?$select=id,displayName,userPrincipalName,jobTitle,department and GET groups('{groupId}')/members?$select=id,displayName,userPrincipalName,jobTitle,department. 3. Intersect the user's reporting peers and group members by stable id or userPrincipalName, excluding the user. Both users and groups entity sets are required; do not infer directory membership from a shared manager. Report empty overlap and data provenance explicitly." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="group_members_reporting_to_manager" />
              <PropertyValue Property="Title" String="Which group members report to a manager?" />
              <PropertyValue Property="Description" String="Filter group members by their reporting manager, joining group membership to user organization profiles." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="managerName" />
                    <PropertyValue Property="Description" String="Manager display name, ID or UPN" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Morgan Reed" />
                  </Record>
                  <Record>
                    <PropertyValue Property="Name" String="groupName" />
                    <PropertyValue Property="Description" String="Group display name or ID" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Which members of group '{groupName}' report directly to '{managerName}'? 1. Resolve the manager with GET users?$filter=startswith(displayName,'{managerName}') or startswith(userPrincipalName,'{managerName}')&amp;$select=id,displayName,userPrincipalName and the group with GET groups?$filter=startswith(displayName,'{groupName}')&amp;$select=id,displayName; clarify ambiguous identities. 2. Query GET groups('{groupId}')/members?$select=id,displayName,userPrincipalName,jobTitle,department to enumerate members. 3. Query GET users('{managerId}')/directReports?$select=id,displayName,userPrincipalName (or GET users('{memberId}')/manager?$select=id,displayName,userPrincipalName for each member) and compare manager id values. Both users and groups entity sets are required. Return only confirmed matches and report live/mock provenance." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="user_and_group_owners_common_manager" />
              <PropertyValue Property="Title" String="Does a user share a manager with group owners?" />
              <PropertyValue Property="Description" String="Compare a user's manager with the managers of a group's owners. Requires group ownership and separate user reporting profiles." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userName" />
                    <PropertyValue Property="Description" String="User display name, ID, UPN, or me" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Avery Adams" />
                  </Record>
                  <Record>
                    <PropertyValue Property="Name" String="groupName" />
                    <PropertyValue Property="Description" String="Group display name or ID" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Does '{userName}' share a reporting manager with any owner of group '{groupName}'? 1. Resolve the user with GET users?$filter=startswith(displayName,'{userName}') or startswith(userPrincipalName,'{userName}')&amp;$select=id,displayName,userPrincipalName and the group with GET groups?$filter=startswith(displayName,'{groupName}')&amp;$select=id,displayName; clarify multiple matches. 2. Query GET groups('{groupId}')/owners?$select=id,displayName,userPrincipalName to obtain owners. 3. Query GET users('{userId}')/manager?$select=id,displayName,userPrincipalName for the user and each group owner, then compare manager id values. Both users and groups entity sets are required; an owner is not necessarily a reporting manager. Missing manager values mean unknown, not no. Include data provenance." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="my_onedrive_files" />
              <PropertyValue Property="Title" String="GET my files in OneDrive" />
              <PropertyValue Property="Description" String="List files and folders in a user's OneDrive root or recent items (from Microsoft Graph Overview Popular API requests)." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userId" />
                    <PropertyValue Property="Description" String="User ID, UPN, or 'me'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="me" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List the files in OneDrive for '{userId}'. If '{userId}' is 'me', query GET me/drive/root/children?$select=id,name,size,webUrl,fileMimeType,lastModifiedDateTime,lastModifiedByDisplayName; otherwise query GET users('{userId}')/drive/root/children?$select=id,name,size,webUrl,fileMimeType,lastModifiedDateTime,lastModifiedByDisplayName." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="last_user_to_modify_file" />
              <PropertyValue Property="Title" String="GET last user to modify a file" />
              <PropertyValue Property="Description" String="Find a file in OneDrive and resolve the full profile of the last user who modified it (from Microsoft Graph Overview Popular API requests)." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="fileName" />
                    <PropertyValue Property="Description" String="File name or keyword" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Agent_Protocol_Demo.docx" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Who was the last user to modify '{fileName}'? 1. Query GET drives('drive-avery')/Microsoft.Graph.searchDriveItems(q='{fileName}')?$select=id,name,lastModifiedDateTime,lastModifiedByDisplayName,lastModifiedByUpn to locate the DriveItem. 2. Navigate to GET driveItems('{itemId}')/lastModifiedByUser?$select=id,displayName,userPrincipalName,mail,jobTitle,department,officeLocation to return the modifier's full profile." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="search_files_by_keyword" />
              <PropertyValue Property="Title" String="Search OneDrive and SharePoint files" />
              <PropertyValue Property="Description" String="Search across OneDrive and group document libraries using the bound searchDriveItems function." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="query" />
                    <PropertyValue Property="Description" String="Document name or topic keyword" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="CSDL" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Search files matching '{query}'. Query GET drives('drive-avery')/Microsoft.Graph.searchDriveItems(q='{query}')?$select=id,name,size,webUrl,fileMimeType,lastModifiedDateTime,lastModifiedByDisplayName." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="my_joined_teams_and_channels" />
              <PropertyValue Property="Title" String="List my Microsoft Teams and channels" />
              <PropertyValue Property="Description" String="Retrieve all Microsoft Teams the user has joined along with their channels." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userId" />
                    <PropertyValue Property="Description" String="User ID, UPN, or 'me'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="me" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List joined Microsoft Teams and channels for '{userId}'. Query GET me/joinedTeams?$select=id,displayName,description,visibility,webUrl&amp;$expand=channels($select=id,displayName,description,membershipType,webUrl)." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="team_channel_messages" />
              <PropertyValue Property="Title" String="Read messages in a Teams channel" />
              <PropertyValue Property="Description" String="Resolve a Microsoft Team and channel by name and list recent channel messages." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="teamName" />
                    <PropertyValue Property="Description" String="Team display name or ID" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Platform Engineering" />
                  </Record>
                  <Record>
                    <PropertyValue Property="Name" String="channelName" />
                    <PropertyValue Property="Description" String="Channel display name or ID" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="CSDL &amp; TypeSpec" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Show recent messages in channel '{channelName}' of team '{teamName}'. 1. Query GET teams?$filter=startswith(displayName,'{teamName}')&amp;$select=id,displayName. 2. Query GET teams('{teamId}')/channels?$filter=startswith(displayName,'{channelName}')&amp;$select=id,displayName,description. 3. Query GET channels('{channelId}')/messages?$top=20&amp;$select=id,subject,bodyContent,fromDisplayName,fromUpn,importance,createdDateTime." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="list_recent_chats" />
              <PropertyValue Property="Title" String="List recent 1:1 and group chats" />
              <PropertyValue Property="Description" String="List the user's recent Microsoft Teams 1:1 and group chats with participants and latest messages." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="chatType" />
                    <PropertyValue Property="Description" String="Optional chatType filter: 'oneOnOne', 'group', or 'all'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="all" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List recent Microsoft Teams chats (filter='{chatType}'). Query GET chats?$select=id,topic,chatType,lastUpdatedDateTime,webUrl&amp;$expand=members($select=id,displayName,userPrincipalName),messages($top=5)." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="my_pending_todo_tasks" />
              <PropertyValue Property="Title" String="List open Microsoft To Do tasks" />
              <PropertyValue Property="Description" String="Retrieve incomplete tasks and high-importance action items from Microsoft To Do task lists." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="importance" />
                    <PropertyValue Property="Description" String="Task importance filter: 'high', 'normal', or 'all'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="all" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List open Microsoft To Do tasks (importance='{importance}'). Query GET me/todoLists?$select=id,displayName,wellknownListName&amp;$expand=tasks($filter=status ne 'completed';$select=id,title,bodyPreview,status,importance,dueDateTime,assignedToUpn)." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="my_m365_unified_groups" />
              <PropertyValue Property="Title" String="GET Microsoft 365 groups I'm a member of" />
              <PropertyValue Property="Description" String="List unified Microsoft 365 groups the user belongs to (from Microsoft Graph Overview Popular API requests)." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="userId" />
                    <PropertyValue Property="Description" String="User ID, UPN, or 'me'" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="me" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="List the Microsoft 365 groups that '{userId}' is a member of. Query GET me/memberOf?$select=id,displayName,description,mail,groupTypes,securityEnabled,visibility and filter to Unified groups." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="meeting_attendee_collaboration_brief" />
              <PropertyValue Property="Title" String="Prepare 360 collaboration brief for a colleague" />
              <PropertyValue Property="Description" String="Microsoft Graph Overview flagship scenario: combine a colleague's profile and manager, shared groups, latest OneDrive documents, recent chats, and open To Do tasks." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="colleagueName" />
                    <PropertyValue Property="Description" String="Colleague display name or UPN" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="Jordan Lee" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Prepare a Microsoft Graph collaboration briefing for '{colleagueName}': 1. Resolve the user and manager with GET users?$filter=startswith(displayName,'{colleagueName}')&amp;$expand=manager,memberOf. 2. Find documents modified by '{colleagueName}' via GET driveItems?$filter=startswith(lastModifiedByDisplayName,'{colleagueName}')&amp;$select=id,name,webUrl,lastModifiedDateTime. 3. Find recent 1:1 or group chats involving '{colleagueName}' via GET chats?$expand=members,messages($top=3). 4. Check open To Do tasks related to '{colleagueName}' via GET todoTasks?$filter=status ne 'completed'." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
            <Record>
              <PropertyValue Property="Name" String="team_channel_files_and_action_items" />
              <PropertyValue Property="Title" String="Correlate Teams channel messages, Drive files, and To Do tasks" />
              <PropertyValue Property="Description" String="Cross-workload Microsoft 365 synthesis joining Teams channel discussions with shared OneDrive/SharePoint specifications and pending To Do tasks." />
              <PropertyValue Property="Arguments">
                <Collection>
                  <Record>
                    <PropertyValue Property="Name" String="topic" />
                    <PropertyValue Property="Description" String="Project or specification topic" />
                    <PropertyValue Property="Required" Bool="false" />
                    <PropertyValue Property="Default" String="MCP" />
                  </Record>
                </Collection>
              </PropertyValue>
              <PropertyValue Property="Messages">
                <Collection>
                  <Record>
                    <PropertyValue Property="Role" String="user" />
                    <PropertyValue Property="Content">
                      <Record>
                        <PropertyValue Property="Type" String="text" />
                        <PropertyValue Property="Text" String="Synthesize Microsoft 365 activity for topic '{topic}' across Teams, OneDrive, and To Do: 1. Query GET teams?$expand=channels and GET channels('ch-mcp-20')/messages?$top=10 for channel discussions mentioning '{topic}'. 2. Query GET drives('drive-avery')/Microsoft.Graph.searchDriveItems(q='{topic}') for matching specification files. 3. Query GET todoTasks?$filter=status ne 'completed' for open action items matching '{topic}'." />
                      </Record>
                    </PropertyValue>
                  </Record>
                </Collection>
              </PropertyValue>
            </Record>
          </Collection>
        </Annotation>
      </EntityContainer>
    </Schema>

    <Schema Namespace="Agent">
      <ComplexType Name="PromptType">
        <Property Name="Name" Type="Edm.String" Nullable="false" />
        <Property Name="Title" Type="Edm.String" Nullable="false" />
        <Property Name="Description" Type="Edm.String" Nullable="false" />
        <Property Name="Arguments" Type="Collection(Agent.PromptArgument)" Nullable="false" />
        <Property Name="Messages" Type="Collection(Agent.PromptMessage)" Nullable="false" />
      </ComplexType>
      <ComplexType Name="PromptArgument">
        <Property Name="Name" Type="Edm.String" Nullable="false" />
        <Property Name="Description" Type="Edm.String" Nullable="false" />
        <Property Name="Required" Type="Edm.Boolean" Nullable="false" />
        <Property Name="Default" Type="Edm.String" Nullable="false" />
      </ComplexType>
      <ComplexType Name="PromptMessage">
        <Property Name="Role" Type="Edm.String" Nullable="false" />
        <Property Name="Content" Type="Agent.TextContent" Nullable="false" />
      </ComplexType>
      <ComplexType Name="TextContent">
        <Property Name="Type" Type="Edm.String" Nullable="false" />
        <Property Name="Text" Type="Edm.String" Nullable="false" />
      </ComplexType>
      <Term Name="Prompts" Type="Collection(Agent.PromptType)" AppliesTo="EntityContainer" />
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
